# EchoSync environment configuration
# Copy to .env and adjust as needed.

# HTTP listen address for the Go API / WebSocket server
ECHO_HTTP_ADDR=:8080

# Redis (Geo index + ephemeral match TTL store)
ECHO_REDIS_ADDR=127.0.0.1:5545
ECHO_REDIS_PASSWORD=
ECHO_REDIS_DB=0

# PostgreSQL (pgvector interest-vector store)
ECHO_PG_DSN=postgres://echosync:echosync@127.0.0.1:5544/echosync?sslmode=disable
ECHO_PG_POOL_MAX=10

# Edge Llama-3-8B inference (Ollama). The server auto-falls-back to the
# deterministic rule-based redactor / template icebreaker when unreachable.
ECHO_OLLAMA_URL=http://127.0.0.1:11434
ECHO_OLLAMA_MODEL=llama3:8b
ECHO_OLLAMA_TIMEOUT_S=20
ECHO_EMBED_PROVIDER=hash        # hash | ollama
ECHO_EMBED_MODEL=nomic-embed-text

# Proximity + ephemeral match engine
ECHO_MATCH_RADIUS_M=15
ECHO_MATCH_TTL_S=900            # 15-minute ephemeral TTL
ECHO_MATCH_SIMILARITY=0.60      # cosine similarity threshold
ECHO_MATCH_TOKENS=3             # tokens required to overlap before matching

# Privacy pipeline
ECHO_PII_MODE=auto              # auto | rule | llama | groq
ECHO_PII_MAX_TRANSCRIPT_BYTES=4096
ECHO_SHOW_RAW_EVENTS=false      # command-center only; never in production

# Cloud PII firewall (Groq Llama-3-8B) — used when ECHO_PII_MODE=auto|groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_S=10

# Live audio streaming transcription (Speechmatics)
SPEECHMATICS_API_KEY=your_speechmatics_api_key_here
SPEECHMATICS_SAMPLE_RATE=16000

# Logging
ECHO_LOG_LEVEL=info